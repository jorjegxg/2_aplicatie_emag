# Valorile 127.0.0.1 de mai jos sunt pentru rularea pe host (scripturi npm din backend/).
# In Docker, docker-compose.yml suprascrie DATABASE_URL si S3_ENDPOINT cu numele
# serviciilor (db / minio), deci nu trebuie schimbate aici.

# Postgres (Docker in WSL)
POSTGRES_USER=emag
POSTGRES_PASSWORD=emag
POSTGRES_DB=emag

# Backup DB orar (backend/scripts/backup-db.sh + /etc/cron.hourly)
# BACKUP_DIR=/home/gxg/2_aplicatie_emag/backups/postgres
# BACKUP_KEEP=48
# BACKUP_DB_CONTAINER=emag-db

# Node app on Windows → Postgres published on localhost:5433
# (5432 e adesea ocupat de Postgres local)
DATABASE_URL=postgres://emag:emag@127.0.0.1:5433/emag

# Cheie pentru criptarea credentialelor marketplace în DB (schimbă-o!)
CREDENTIALS_ENCRYPTION_KEY=schimba-cu-o-cheie-lunga-secreta

# Parola de acces la UI / API. Odată introdusă, rămâne pe browser ~1 an (cookie).
# Lasă gol doar dacă vrei aplicația deschisă fără autentificare.
APP_PASSWORD=schimba-parola-acces
REVIEW_CALLS_PASSWORD=schimba-parola-apeluri

# TTL cache oglinda remote eMAG in memorie (ms). Default 1h. Se golește la restart.
CHANNEL_CACHE_TTL_MS=3600000

# Web Push (bara de notificări pe telefon). Opțional — dacă lipsesc, se generează
# automat în backend/data/vapid-keys.json la primul start.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# Trendyol Product V2: storefront (piață/monedă) + limba titlu/descriere.
# Fără Accept-Language, API-ul întoarce adesea engleză pe RO.
# Defaults: STOREFRONT=RO → monedă RON, limba ro.
# TRENDYOL_STOREFRONT_CODE=RO
# TRENDYOL_ACCEPT_LANGUAGE=ro

# Comenzi Trendyol → scad stocul din catalog. Webhook: POST /api/webhooks/ty/order
# cu header x-api-key = TRENDYOL_WEBHOOK_TOKEN (înregistrare: scripts/register-trendyol-webhook.js).
# Poller de rezervă la fiecare N minute (0 = oprit), pe comenzile din ultimele ore.
# TRENDYOL_WEBHOOK_TOKEN=
# TRENDYOL_ORDER_POLL_MINUTES=5
# TRENDYOL_ORDER_LOOKBACK_HOURS=72

# Callback-uri eMAG (cont eMAG > Setari): https://<domeniu>/api/webhooks/emag/<tip>?token=EMAG_WEBHOOK_TOKEN
# tipuri: order, order-cancel, awb, return, product, documentation, courier.
# Poller de rezervă pentru comenzi eMAG la fiecare N minute (0 = oprit).
# EMAG_WEBHOOK_TOKEN=
# EMAG_ORDER_POLL_MINUTES=5

# După o comandă/anulare, stocul nou din catalog se trimite automat pe celelalte canale (0 = oprit).
# AUTO_STOCK_PUSH=1

# MinIO / S3 (Docker: docker compose up -d minio)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=emag-products
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Cloudflare R2 in loc de MinIO (pozele raman accesibile si cu PC-ul inchis):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ENDPOINT_DOCKER=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  # docker-compose il foloseste in loc de minio
# S3_REGION=auto
# S3_ACCESS_KEY= / S3_SECRET_KEY=  (token R2 „Object Read & Write” pe bucket)
# Domeniul public al bucket-ului: eMAG ia pozele direct de aici, nu prin PUBLIC_BASE_URL.
# PUBLIC_IMAGE_BASE_URL=https://poze.domeniul-tau.ro

# URL-ul public al aplicatiei — de aici descarca eMAG pozele trimise pe marketplace.
# Fara el, trimiterea pozelor da eroare (link-urile trebuie absolute si accesibile).
# PUBLIC_BASE_URL=https://domeniul-tau.ro
# Cheia cu care se semneaza link-urile de poze date in afara (/public/product-image/...).
# Lasa gol: se genereaza una si se pastreaza in backend/data/image-signing.json.
# PUBLIC_IMAGE_SECRET=

# Base (BaseLinker): tot ce pleaca din aplicatie merge in Base; aplicatia nu mai scrie direct
# pe eMAG / Trendyol (doar citeste). Tokenul: Base -> Contul meu -> API.
# BASE_TOKEN=
# 1 = trimite pe bune in Base (pagina „Pregătire Base” si coada); 0 = doar arata ce ar pleca.
# BASE_SEND=0
# Catalogul, lista de preturi si depozitul din Base.
# BASE_INVENTORY_ID=722
# BASE_PRICE_GROUP_ID=699
# BASE_WAREHOUSE=bl_100786
# 1 = comenzile se citesc din Base (in locul citirii directe de la eMAG / Trendyol).
# BASE_ORDERS=0
# BASE_ORDER_POLL_MINUTES=5
# BASE_ORDER_LOOKBACK_HOURS=72

# Coada de trimiteri amanate in Base (serviciul `queue`, vezi backend/queue-worker.js).
# QUEUE_INTERVAL_SEC=300
# QUEUE_RETRY_MINUTES=30

# Serviciul `validari` (backend/validari-worker.js): urmareste validarile eMAG RO -> HU -> BG.
# VALIDARI_INTERVAL_SEC=300
# Mesaje pe Telegram la iesirea din validare: botul de la @BotFather si chat id-ul tau.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Serviciul validari: retrimite din Base pe tara eMAG refuzata (UPDATE_NOT_ALLOWED_DIFFERENT_PLATFORM)
VALIDARI_SEND=0
VALIDARI_RETRY_MIN=30
VALIDARI_MAX_TRIES=3

# Serviciul `boti` (pagina Boți): boți care doar citesc din Base / eMAG / Trendyol și îți vorbesc.
# Contul Claude se poate pune și din pagina Boți → Cont Claude (are întâietate față de .env).
# Abonament: rulează `claude setup-token` și pune tokenul aici; sau o cheie API.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
# Serviciul `voce` (TTS + transcriere pe CPU): modelul Whisper și câte nuclee folosește.
# VOCE_STT_MODEL=large-v3-turbo
# VOCE_STT_THREADS=6
